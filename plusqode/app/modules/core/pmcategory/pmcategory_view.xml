<?xml version="1.0" encoding="utf-8"?>
<plusqode>
  
  <view type="table" name="category_table" model="category">
      <field name="name"/>
      <field name="tax_rate_id.name"/>
  </view>
  
  <view type="tab" name="category_tab" model="category" subModelName='product_table' subViewType='icon'/>

  <view type="form" name="category_form" model="category">
      
      <layout>
          <label label="user" alignment="center" icon="picons/core/models/category.png" size="(128, 128)" newline="false" hs="(50, 0)"/>
          <label label="user" alignment="center" icon="picons/core/models/category.png" size="(128, 128)" newline="false" hs="(150, 0)"/>
          <label label="user" alignment="center" icon="picons/core/models/category.png" size="(128, 128)" newline="false" hs="(200, 0)"/>
      </layout>
      
      <layout>
          <separator/>
      </layout>

      <layout minimumWidth="600" minimumHeight="50">
          <field name="name" arrangement="vertical" newline="true"/>
      </layout>
      <layout>
          <field name="tax_rate_id"/>
          <field name="icon"/>
          <field name="apply_tax_rate_to_category_button" label="Apply Tax Rate All"/>
          <field name="apply_tax_rate_to_partial_product_button" label="Apply Tax Rate Partial"/>
      </layout>

      <tab>
          <panel name="Products">
              <field name="product_table"/>
          </panel>
          <panel name="Categories">
              <field name="category_table"/>
          </panel>
      </tab>

  </view>



  <view type="controlpanel">
      <layout name="control-panel">
          <menusection newline="false" spacing="0" maximumWidth="70">
              <menuitem name="Up"  action="up" icon=":/picons/core/actions/up.png" newline="true"/>
              <menuitem name="Down"  action="down" icon=":/picons/core/actions/down.png"/>
          </menusection>
          <menusection  newline="false">
              <menuitem name="New"  action="new" icon=":/picons/core/actions/new.png" minimumHeight="60" maximumWidth="70"/>
              <menuitem name="Edit"  action="edit" icon=":/picons/core/actions/edit.png" minimumHeight="60" maximumWidth="70"/>
              <menuitem name="Delete"  action="delete" icon=":/picons/core/actions/delete.png" minimumHeight="60" maximumWidth="70"/>
              <menuitem name="Duplicate"  action="duplicate" icon=":/picons/core/actions/duplicate.png" minimumHeight="60" maximumWidth="70"/>
              <menusection name="Other" position="10" maximumWidth="70">
                  <menuitem name="Apply TaxRate to all Products"  action="applyTaxRateToAllProduct" icon=":/picons/core/actions/ok.png"/>
              </menusection>
          </menusection>
          <menusection/> <!-- it needs as horizontal spacer -->
      </layout>
  </view>



  <view type="views" value="[table, icon, tab]"/>

</plusqode>

