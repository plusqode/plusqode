        mainIcon="picons/core/models/quickorder.png" iconSize="(256, 256)"
        author="{name: 'PlusQode', address: 'Via Nino Arcidiacono 49/A,95018 Riposto(CT)'}"
        description="Point of Sale"
    />

    <menuitem name="Categories" ref="{modelName: 'pos_category'}"/>
